# MaterialHub Environment Configuration
# Copy this file to .env for local development. Never commit real credentials.

# PostgreSQL Database Connection
DATABASE_URL="postgresql://localhost:5432/materialhub_dev"
TEST_DATABASE_URL="postgresql://localhost:5432/materialhub_test"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-a-minimum-32-character-cryptographic-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Application Public URL
APP_URL="http://localhost:3000"

# Object Storage Configuration (S3-Compatible or Local Development Adapter)
# Set STORAGE_DRIVER="s3" in production when S3 credentials are configured.
STORAGE_DRIVER="local"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET="materialhub-assets"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# Public Base URL for Served Product Images
IMAGE_PUBLIC_BASE_URL="http://localhost:3000/api/v1/storage"
